<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    Tela Principal do Aplicativo de Tarefas
    
    Estrutura:
    - Painel lateral esquerdo: Navegação e controles
    - Área central: Lista de tarefas e formulários
    - Painel direito: Detalhes da tarefa selecionada
    
    Funcionalidades:
    - Visualizar lista de tarefas
    - Adicionar novas tarefas
    - Remover tarefas
    - Alterar status de conclusão
    - Visualizar detalhes
    - Navegar para cronograma
-->
<SplitPane dividerPositions="0.25" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" 
           minHeight="500.0" minWidth="800.0" prefHeight="600.0" prefWidth="1000.0" 
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.ifpb.todolist.controller.TelaPrincipalController">
    <items>
        <!-- PAINEL LATERAL ESQUERDO - NAVEGAÇÃO -->
        <VBox alignment="TOP_CENTER" minWidth="180.0" prefWidth="200.0" spacing="20.0" 
              style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
            </padding>
            <children>
                <!-- Logo/Título do app -->
                <Label alignment="CENTER" text="📝 APP de Tarefas" textAlignment="CENTER" wrapText="true">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <!-- Botões de navegação -->
                <VBox alignment="CENTER" spacing="10.0">
                    <children>
                        <!-- Botão Lista (atual - desabilitado) -->
                        <Button alignment="CENTER" disable="true" mnemonicParsing="false" 
                               prefHeight="35.0" prefWidth="150.0" text="📋 Lista" 
                               style="-fx-background-color: #2196F3; -fx-text-fill: white;">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Button>

                        <!-- Botão Cronograma -->
                        <Button alignment="CENTER" mnemonicParsing="false" 
                               onAction="#irParaTelaCronograma" prefHeight="35.0" prefWidth="150.0" 
                               text="📅 Cronograma">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <!-- Separador -->
                <Separator />

                <!-- Ações rápidas -->
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label text="Ações Rápidas:">
                            <font>
                                <Font name="System Bold" size="11.0" />
                            </font>
                        </Label>
                        
                        <Button alignment="CENTER" mnemonicParsing="false" 
                               onAction="#mostrarFormulario" prefHeight="30.0" prefWidth="140.0" 
                               text="➕ Nova Tarefa" />
                        
                        <Button alignment="CENTER" mnemonicParsing="false" 
                               onAction="#alternarStatusConclusao" prefHeight="30.0" prefWidth="140.0" 
                               text="✅ Concluir" />
                        
                        <Button alignment="CENTER" mnemonicParsing="false" 
                               onAction="#removerTarefa" prefHeight="30.0" prefWidth="140.0" 
                               text="🗑️ Remover" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <!-- ÁREA PRINCIPAL -->
        <VBox minWidth="400.0" spacing="0.0">
            <children>
                <!-- Cabeçalho -->
                <VBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                    </padding>
                    <children>
                        <Label text="📋 Visualização em Lista">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        
                        <Label text="Gerencie suas tarefas de forma simples e eficiente">
                            <VBox.margin>
                                <Insets top="5.0" />
                            </VBox.margin>
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Área principal com SplitPane horizontal -->
                <SplitPane dividerPositions="0.6" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- Área da lista e formulário -->
                        <VBox spacing="15.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="10.0" top="20.0" />
                            </padding>
                            <children>
                                <!-- Seção da lista -->
                                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="📝 Suas Tarefas:">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        
                                        <!-- Lista de tarefas -->
                                        <ListView fx:id="listaViewTarefas" prefHeight="300.0" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>

                                <!-- Formulário de adição (inicialmente oculto) -->
                                <VBox fx:id="painelFormulario" managed="false" spacing="15.0" visible="false" 
                                      style="-fx-background-color: #f9f9f9; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8;">
                                    <padding>
                                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                    </padding>
                                    <children>
                                        <!-- Título do formulário -->
                                        <Label text="➕ Nova Tarefa">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>

                                        <!-- Campo título -->
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Título: *" />
                                                <TextField fx:id="campoTitulo" 
                                                         promptText="Digite o título da tarefa" />
                                            </children>
                                        </VBox>

                                        <!-- Campo descrição -->
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Descrição:" />
                                                <TextField fx:id="campoDescricao" 
                                                         promptText="Digite a descrição (opcional)" />
                                            </children>
                                        </VBox>

                                        <!-- Campo data de vencimento -->
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label text="Data de Vencimento: *" />
                                                <DatePicker fx:id="seletorDataVencimento" 
                                                          promptText="Selecione a data" />
                                            </children>
                                        </VBox>

                                        <!-- Checkbox concluída -->
                                        <CheckBox fx:id="checkboxConcluida" mnemonicParsing="false" 
                                                text="Marcar como concluída" />

                                        <!-- Botões do formulário -->
                                        <HBox alignment="CENTER" spacing="10.0">
                                            <VBox.margin>
                                                <Insets top="10.0" />
                                            </VBox.margin>
                                            <children>
                                                <Button mnemonicParsing="false" onAction="#adicionarTarefa" 
                                                       text="💾 Salvar" prefWidth="80.0" />
                                                <Button mnemonicParsing="false" onAction="#cancelarFormulario" 
                                                       text="❌ Cancelar" prefWidth="80.0" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <!-- PAINEL DE DETALHES -->
                        <VBox fx:id="painelDetalhes" managed="false" minWidth="250.0" spacing="15.0" visible="false" 
                              style="-fx-background-color: #fafafa; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <!-- Título da seção -->
                                <Label text="🔍 Detalhes da Tarefa">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                
                                <Separator />

                                <!-- Título da tarefa -->
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Título:" />
                                        <Label fx:id="labelTituloDetalhes" wrapText="true">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Descrição -->
                                <VBox spacing="5.0">
                                    <children>
                                        <Label text="Descrição:" />
                                        <ScrollPane fitToWidth="true" prefHeight="60.0">
                                            <content>
                                                <TextArea fx:id="areaDescricaoDetalhes" editable="false" 
                                                        wrapText="true" style="-fx-background-color: transparent;" />
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>

                                <Separator />

                                <!-- Informações de data e status -->
                                <VBox spacing="8.0">
                                    <children>
                                        <Label fx:id="labelDataCriacao" />
                                        <Label fx:id="labelDataVencimento" />
                                        <Label fx:id="labelStatusConclusao" />
                                    </children>
                                </VBox>

                                <Separator />

                                <!-- Ações da tarefa -->
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Ações:">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        
                                        <Button mnemonicParsing="false" onAction="#alternarStatusConclusao" 
                                               text="🔄 Alterar Status" prefWidth="120.0" />
                                        
                                        <Button mnemonicParsing="false" onAction="#removerTarefa" 
                                               text="🗑️ Excluir Tarefa" prefWidth="120.0" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </items>
                </SplitPane>
            </children>
        </VBox>
    </items>
</SplitPane>
